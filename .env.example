# ========================================
# Team Insight AI — Environment Variables
# Copy to .env and fill in values
# ========================================

# Application
ENVIRONMENT=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database
DB_USER=teaminsight
DB_PASSWORD=changeme_in_production
DATABASE_URL=postgresql+asyncpg://teaminsight:changeme@localhost:5432/team_insight_ai

# Microsoft Entra ID (Azure AD)
AZURE_TENANT_ID=your-tenant-id-here
AZURE_CLIENT_ID=your-client-id-here
AZURE_CLIENT_SECRET=your-client-secret-here

# JWT
JWT_SECRET_KEY=generate-a-secure-random-key-here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# AI (use Azure OpenAI for production)
OPENAI_API_KEY=sk-your-openai-key
AZURE_OPENAI_ENDPOINT=https://your-instance.openai.azure.com/
AZURE_OPENAI_API_KEY=your-azure-openai-key
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# Redis (for AI response caching)
REDIS_URL=redis://localhost:6379

# NextAuth (for Next.js session management)
NEXTAUTH_SECRET=generate-a-secure-random-key-here
NEXTAUTH_URL=http://localhost:3000

# Notifications
TEAMS_WEBHOOK_URL=https://your-org.webhook.office.com/...
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=noreply@company.com
SMTP_PASSWORD=your-smtp-password

# Sentry (error tracking)
SENTRY_DSN=https://...@o....ingest.sentry.io/...
