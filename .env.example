# ============================================================
# Team Insight AI — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ============================================================

# ---- Database ------------------------------------------------
DB_USER=teaminsight
DB_PASSWORD=change_me_secure_password

# ---- Azure / Entra ID ----------------------------------------
AZURE_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_CLIENT_SECRET=your_azure_client_secret

# ---- OpenAI / Azure OpenAI -----------------------------------
# Use one of: plain OpenAI OR Azure OpenAI
OPENAI_API_KEY=sk-...
AZURE_OPENAI_ENDPOINT=https://your-instance.openai.azure.com/

# ---- App Secrets ---------------------------------------------
JWT_SECRET_KEY=generate_a_long_random_secret_here
NEXTAUTH_SECRET=another_long_random_secret

# ---- Degreed Integration (optional) --------------------------
# Obtain Client ID and Client Secret from your Degreed Technical Admin.
# Required scopes: users:read, user_skills:read, skill_ratings:read,
#                  skill_plans:read, required_learning:read, completions:read
DEGREED_CLIENT_ID=
DEGREED_CLIENT_SECRET=
DEGREED_BASE_URL=https://api.degreed.com
DEGREED_AUTH_URL=https://degreed.com/oauth/token

# ---- Environment ---------------------------------------------
ENVIRONMENT=development
